{
  "name": "antigravity-rtl",
  "version": "1.4.1",
  "description": "A smart RTL (Right-to-Left) patcher with UI settings for Antigravity & Antigravity IDE.",
  "main": "./bin/index.js",
  "scripts": {
    "test": "node --test",
    "autostart": "powershell -ExecutionPolicy Bypass -File ./auto-patcher/install-autostart.ps1",
    "autostart:status": "powershell -ExecutionPolicy Bypass -File ./auto-patcher/status.ps1",
    "autostart:uninstall": "powershell -ExecutionPolicy Bypass -File ./auto-patcher/uninstall-autostart.ps1"
  },
  "keywords": [
    "antigravity",
    "rtl",
    "persian",
    "arabic",
    "hebrew",
    "patcher",
    "electron",
    "asar"
  ],
  "author": "mmnaderi",
  "license": "MIT",
  "files": [
    "bin",
    "extension",
    "README.md"
  ],
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "type": "module",
  "bin": {
    "antigravity-rtl": "bin/index.js"
  }
}
